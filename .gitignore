# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit API keys
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Chaos QA run artifacts (screenshots, .webm videos, report.json)
public/runs/*
!public/runs/.gitkeep

# Batch lead-gen output
LEADS.md
